# Gemini API Configuration (Google AI Studio Free Tier)
GEMINI_API_KEY=YOUR_NEW_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Retrieval Configuration
DISCLOSURE_SIMILARITY_THRESHOLD=0.75
PRECEDENT_TOP_K=3
RULE_TOP_K=5

# Vector Store Path (for persistent local vector cache/index)
VECTOR_STORE_PATH=./data/vector_store.json
ANALYSIS_CACHE_PATH=./data/analysis_cache.json

# Data Engineering Service Integration
DATA_ENGINEERING_BASE_URL=http://localhost:5000
USE_DATA_ENGINEERING_SERVICE=true

